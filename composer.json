{
    "name": "intifact/sdk",
    "description": "SDK PHP para la API de Facturacion Electronica SUNAT de Intifact (Peru): facturas, boletas, notas de credito/debito, guias de remision, resumenes diarios.",
    "keywords": [
        "sunat",
        "facturacion",
        "peru",
        "intifact",
        "factura-electronica",
        "boleta",
        "nota-credito",
        "guia-remision"
    ],
    "homepage": "https://intifact.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Roger",
            "homepage": "https://intifact.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": { "Intifact\\Sdk\\" : "lib/" }
    },
    "autoload-dev": {
        "psr-4": { "Intifact\\Sdk\\Test\\" : "test/" }
    }
}
